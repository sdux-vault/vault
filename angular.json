{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "docs-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/docs-app",
      "sourceRoot": "apps/docs-app",
      "prefix": "sdux",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/docs-app/main.ts",
            "tsConfig": "apps/docs-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "apps/docs-app/assets",
                "output": "assets"
              }
            ],
            "styles": ["apps/docs-app/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/ui/styles/scss"]
            },
            "allowedCommonJsDependencies": [
              "prismjs",
              "prismjs/components/prism-typescript"
            ]
          },
          "configurations": {
            "enterprise": {
              "fileReplacements": [
                {
                  "replace": "apps/docs-app/environments/environment.ts",
                  "with": "apps/docs-app/environments/environment.enterprise.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/docs-app/environments/environment.ts",
                  "with": "apps/docs-app/environments/environment.dev.ts"
                }
              ]
            },
            "pro": {
              "fileReplacements": [
                {
                  "replace": "apps/docs-app/environments/environment.ts",
                  "with": "apps/docs-app/environments/environment.pro.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "bypass-license": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "apps/docs-app/environments/environment.ts",
                  "with": "apps/docs-app/environments/environment.bypass-license.ts"
                }
              ]
            },
            "offline-docs": {
              "index": "apps/docs-app/index.offline.html",
              "baseHref": "./",
              "deployUrl": "./",
              "outputHashing": "none",
              "optimization": true,
              "sourceMap": false,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15MB",
                  "maximumError": "20MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "15kB",
                  "maximumError": "30kB"
                }
              ]
            }
          },
          "defaultConfiguration": "enterprise"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "enterprise": {
              "buildTarget": "docs-app:build:enterprise"
            },
            "development": {
              "buildTarget": "docs-app:build:development"
            },
            "pro": {
              "buildTarget": "docs-app:build:pro"
            },
            "bypass-license": {
              "buildTarget": "docs-app:build:bypass-license"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "karmaConfig": "apps/docs-app/karma.conf.js",
            "tsConfig": "apps/docs-app/tsconfig.spec.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/docs-app/assets",
                "output": "/assets/"
              }
            ],
            "styles": ["apps/docs-app/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/ui/styles/scss"]
            },
            "fileReplacements": [
              {
                "replace": "apps/docs-app/environments/environment.ts",
                "with": "apps/docs-app/environments/environment.dev.ts"
              }
            ],
            "codeCoverageExclude": [
              "**/testing/data/**",
              "**/docs-app/app/builder/services/files/pipeline-file-builder.abstract.ts",
              "**/docs-app/app/docs/resolve/value/example/resolve-value.example.component.ts"
            ]
          }
        }
      }
    },
    "addons": {
