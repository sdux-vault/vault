    "devtools-ui": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "apps/devtools-ui",
      "sourceRoot": "apps/devtools-ui/src",
      "prefix": "sdux",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": ["reflect-metadata"],
            "browser": "apps/devtools-ui/src/main.ts",
            "tsConfig": "apps/devtools-ui/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/devtools-ui/public"
              },
              {
                "glob": "**/*",
                "input": "apps/devtools-ui/src/assets",
                "output": "assets"
              }
            ],
            "styles": ["apps/devtools-ui/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/ui/styles/scss"]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "none"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "devtools-ui:build:production"
            },
            "development": {
              "buildTarget": "devtools-ui:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "apps/devtools-ui/tsconfig.spec.json",
            "karmaConfig": "apps/devtools-ui/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/devtools-ui/public"
              }
            ],
            "styles": ["apps/devtools-ui/src/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/ui/styles/scss"]
            }
          }
        }
      }
    },

    "devtools-demo": {
      "projectType": "application",
      "schematics": {
