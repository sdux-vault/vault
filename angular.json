              "apps/devtools-ui/demo/styles-demo.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["libs/ui/styles/scss"]
            }
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false,
              "fileReplacements": [
                {
                  "replace": "apps/devtools-ui/demo/environments/environment.ts",
