# ── Dockerfile.node (development) ──
# Angular 21 requires Node >=20.19.0
FROM node:22-bullseye

# Set working directory
WORKDIR /usr/src/app

# HOST_IP is passed as a build arg from docker-compose (resolved at build time
# on the Mac). This makes localhost:4873/Verdaccio reachable during npm install
# since network:host doesn't work on macOS Docker Desktop builds.
ARG HOST_IP=host-gateway
COPY ./package.json ./
RUN echo "registry=http://${HOST_IP}:4873" > /root/.npmrc && \
    echo "@sdux-vault:registry=http://${HOST_IP}:4873" >> /root/.npmrc && \
    npm install

# CMD is intentionally omitted — docker-compose overrides it with:
#   npm run start -- --host 0.0.0.0