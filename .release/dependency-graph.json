{
  "levels": [
    ["@sdux-vault/shared"],
    ["@sdux-vault/devtools"],
    ["@sdux-vault/engine"],
    ["@sdux-vault/addons", "@sdux-vault/core"],
    ["@sdux-vault/angular", "@sdux-vault/react"]
  ],

  "libraries": {
    "@sdux-vault/shared": {
      "type": "library",
      "source": "npm",
      "dependencies": [],
      "dependents": [
        "@sdux-vault/devtools",
        "@sdux-vault/engine",
        "@sdux-vault/addons",
        "@sdux-vault/core",
        "@sdux-vault/angular",
        "@sdux-vault/react"
      ]
    },

    "@sdux-vault/devtools": {
      "type": "library",
      "source": "npm",
      "dependencies": ["@sdux-vault/shared"],
      "dependents": ["@sdux-vault/engine"]
    },

    "@sdux-vault/engine": {
      "type": "library",
      "source": "npm",
      "dependencies": ["@sdux-vault/devtools", "@sdux-vault/shared"],
      "dependents": [
        "@sdux-vault/addons",
        "@sdux-vault/core",
        "@sdux-vault/angular",
        "@sdux-vault/react"
      ]
    },

    "@sdux-vault/addons": {
      "type": "library",
      "source": "npm",
      "dependencies": ["@sdux-vault/engine", "@sdux-vault/shared"],
      "dependents": []
    },

    "@sdux-vault/core": {
      "type": "library",
      "source": "npm",
      "dependencies": ["@sdux-vault/engine", "@sdux-vault/shared"],
      "dependents": ["@sdux-vault/angular", "@sdux-vault/react"]
    },

    "@sdux-vault/angular": {
      "type": "library",
      "source": "npm",
      "dependencies": [
        "@sdux-vault/core",
        "@sdux-vault/engine",
        "@sdux-vault/shared"
      ],
      "dependents": []
    },

    "@sdux-vault/react": {
      "type": "library",
      "source": "npm",
      "dependencies": [
        "@sdux-vault/core",
        "@sdux-vault/engine",
        "@sdux-vault/shared"
      ],
      "dependents": []
    }
  }
}
