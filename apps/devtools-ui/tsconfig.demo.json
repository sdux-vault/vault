{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../../",
    "composite": true,
    "outDir": "../../out-tsc/demo",
    "types": ["chrome"],
    "paths": {
      "@sdux-vault/addons": ["libs/addons/src/public-api"],
      "@sdux-vault/core": ["libs/core/src/public-api"],
      "@sdux-vault/angular": ["libs/core-extensions/angular/src/public-api"],
      "@sdux-vault/testing-utils": ["libs/testing/utils/src/public-api"],
      "@sdux-vault/devtools-ui": ["apps/devtools-ui/src/public-api"],
      "@sdux-vault/ui/web-components": ["libs/ui/web-components/src/public-api"]
    }
  },
  "include": [
    "demo/**/*.ts",
    "src/**/*.ts",
    "../../libs/addons/src/**/*.ts",
    "../../libs/core/src/**/*.ts",
    "../../libs/core-extensions/angular/src/**/*.ts"
  ],
  "exclude": ["**/*.spec.ts", "../../libs/**/*.spec.ts"]
}
