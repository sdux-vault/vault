{
  "manifest_version": 3,
  "name": "SDuX Vault DevTools",
  "version": "0.0.50",
  "description": "Developer tools panel for inspecting SDuX Vault state and events.",

  "devtools_page": "devtools/devtools.html",

  "background": {
    "service_worker": "background/background.js"
  },

  "icons": {
    "128": "icons/brand-128.png"
  },

  "permissions": [],
  "host_permissions": ["<all_urls>"],

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "bridge/bridge-inject.js",
        "assets/brand/brand-landscape-dark.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
